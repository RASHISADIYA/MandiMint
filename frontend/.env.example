# Public Privy app identifier (from https://dashboard.privy.io — safe for client bundle)
VITE_PRIVY_APP_ID=

# Optional Privy app client ID for environment-specific settings
VITE_PRIVY_CLIENT_ID=

# MST Testnet — obtain official values from MST / project documentation.
# The MandiMint repo does not hardcode these; Hardhat uses MST_TESTNET_* server env vars.
# Commonly documented for MST Testnet (verify before production):
#   Chain ID: 91562037
#   RPC: https://testnetrpc.mstblockchain.com
#   Explorer: https://testnet.mstscan.com/
VITE_MST_TESTNET_CHAIN_ID=
VITE_MST_TESTNET_RPC_URL=
VITE_MST_TESTNET_EXPLORER_URL=
VITE_MST_TESTNET_CURRENCY_SYMBOL=tMSTC
VITE_MST_TESTNET_CURRENCY_NAME=MST Testnet
VITE_MST_TESTNET_CURRENCY_DECIMALS=18

# Optional trusted backend for authoritative role verification (Bearer token from Privy).
# When unset, onboarding offers a clearly labelled local role; FPO writes still require isManager.
VITE_MANDIMINT_API_BASE_URL=

# MandiMint contract on MST Testnet (public address only)
VITE_MANDIMINT_CONTRACT_ADDRESS=

# Local Hardhat integration (development only). Use the Vite proxy URL because
# the Hardhat JSON-RPC node does not allow browser POST requests via CORS.
# VITE_MST_TESTNET_CHAIN_ID=31337
# VITE_MST_TESTNET_RPC_URL=http://localhost:5173/hardhat-rpc
# VITE_MANDIMINT_CONTRACT_ADDRESS=<address printed by npm run deploy:local>

# ==============================================================================
# MandiMint Root / Hardhat Secure Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# - This file is a template only. Copy to .env for local private keys.
# - NEVER commit .env to source control.
# - NEVER paste real private keys or seed phrases in chats or commit messages.
# ==============================================================================

# ------------------------------------------------------------------------------
# MST Testnet (Chain ID 91562037)
# ------------------------------------------------------------------------------
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_TESTNET_CHAIN_ID=91562037
MST_TESTNET_EXPLORER_URL=https://testnet.mstscan.com

# Verified Deployed MandiMint Contract Address on MST Testnet
MANDIMINT_CONTRACT_ADDRESS=0x06289D9c452369abcb9bc1b5D6Adf80982C5679C

# Private key of the deployer account on MST Testnet (never share or commit)
MST_TESTNET_DEPLOYER_PRIVATE_KEY=

# Optional Manager address to authorize via scripts
# MANAGER_ADDRESS=0x...

# ------------------------------------------------------------------------------
# MST Mainnet (Chain ID 4646) - Prepared for Production Release
# ------------------------------------------------------------------------------
MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com/
MST_MAINNET_CHAIN_ID=4646

# Private key of the deployer account on MST Mainnet (must be funded with MSTC)
MST_MAINNET_DEPLOYER_PRIVATE_KEY=

# Safety lock: Must be explicitly set to 'true' to broadcast mainnet deployment
CONFIRM_MAINNET_DEPLOYMENT=false
